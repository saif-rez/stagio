# --- Server ---
NODE_ENV=development
PORT=4000
# Public URL of this API (used to build signed file links)
API_URL=http://localhost:4000
# Lovable frontend URL (only origin allowed by CORS, used in email links)
FRONTEND_URL=http://localhost:8080

# --- Database (PostgreSQL: local, Neon or Supabase) ---
# Neon: use the "-pooler" URL here and add &pgbouncer=true
DATABASE_URL=postgresql://stagio:stagio@localhost:5432/stagio?schema=public
# Direct (non-pooled) connection, used by Prisma migrations.
# Neon: same URL without "-pooler" in the host. Locally: same value as DATABASE_URL.
DIRECT_URL=postgresql://stagio:stagio@localhost:5432/stagio?schema=public

# --- Auth ---
# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7
COOKIE_NAME=stagio_session

# --- Private files (internship certificates) ---
STORAGE_DIR=./storage
FILE_URL_SECRET=change-me-to-another-long-random-string-32-chars
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=5

# --- Rate limiting ---
# Login / sign-up / OTP attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20

# --- Email (Nodemailer SMTP). Leave SMTP_HOST empty in dev to print emails in the console. ---
# Required in production. Test with: npm run email:test -- you@example.com
# Gmail (app password, ~500/day):  SMTP_HOST=smtp.gmail.com     SMTP_PORT=465 SMTP_SECURE=true  SMTP_USER=you@gmail.com
# Brevo (free 300/day):            SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_SECURE=false SMTP_USER=<Brevo SMTP login>
# Resend (verified domain):        SMTP_HOST=smtp.resend.com    SMTP_PORT=465 SMTP_SECURE=true  SMTP_USER=resend SMTP_PASSWORD=<API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Stagio <no-reply@stagio.tn>"

# --- Seed (first admin account) ---
SEED_ADMIN_EMAIL=admin@stagio.tn
SEED_ADMIN_PASSWORD=change-me-admin-password

# --- Scheduled jobs (node-cron, Africa/Tunis timezone) ---
CRON_ENABLED=true
# Daily new-offers digest
DIGEST_CRON=0 8 * * *
