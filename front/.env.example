# --- Development ---
# Vite proxies /api to the backend (see vite.config.ts). Backend address (default http://localhost:4000):
API_PROXY_TARGET=http://localhost:4000

# --- Production (Vercel → Settings → Environment Variables) ---
# Backend URL on Render. The site proxies /api/* to it (src/routes/api/$.ts), so the browser
# never calls Render directly and the session cookie stays first-party.
API_ORIGIN=https://stagio-api.onrender.com

# Leave empty: the frontend calls its own /api.
VITE_API_URL=
