# Dev: leave VITE_API_URL empty. Vite proxies /api to the backend (see vite.config.ts).
# Backend address used by that proxy (default http://localhost:4000):
API_PROXY_TARGET=http://localhost:4000

# Production: public URL of the API when it is not served on the same domain as the frontend,
# e.g. https://api.stagio.tn (the backend's FRONTEND_URL must then be this site's URL).
VITE_API_URL=
